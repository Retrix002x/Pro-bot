# Copy this file to .env and fill in the two values below.

# The static short link from LootLabs' "Create Monetized Links" -> Single
# Link flow, e.g. https://loot-link.com/s?xxxx
# (Find it after you finish creating the link in the LootLabs dashboard.)
LOOTLABS_LOOT_URL=

# A random secret YOU make up -- not something LootLabs gives you. Generate
# one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Then paste the SAME value into two places:
#   1. Here
#   2. The end of the Postback URL you configure in LootLabs' Advanced tab:
#      https://your-domain.com/postback?token=<PASTE_HERE>
POSTBACK_TOKEN=
